# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# The three variables below are read automatically by `docker compose`
# (it loads .env from this directory) and have working defaults baked
# into docker-compose.yml, so `docker compose up -d` runs fine even if
# you never create a .env file at all. Create one if you want to change
# a password, or before pointing this at anything beyond a laptop demo.

# Postgres password, used by both the postgres container and the
# DATABASE_URL docker-compose builds for jira-listener.
POSTGRES_PASSWORD=devfinops

# Shared-secret header jira-listener checks on incoming Jira webhooks
# (see jira-listener/jira-listener.js). This is a placeholder, not real
# OAuth — see that file's own comment before pointing it at a real Jira
# instance.
JIRA_WEBHOOK_SECRET=changeme

# Grafana's admin login (username is always "admin").
GF_SECURITY_ADMIN_PASSWORD=devfinops


# ---------------------------------------------------------------------
# Everything below is NOT read from this file automatically — docker
# compose only loads the three variables above. These are the env vars
# for the two Node scripts you run by hand (see README.md); export them
# in your shell, or prefix the command, the same way their own --help
# / usage comments show.
# ---------------------------------------------------------------------

# ingestion-service (ingestion-service/ingest.js)
# ---------------------------------------------------------------------
# From your host machine, Postgres is reachable at localhost:5432 (the
# port docker-compose publishes) — NOT postgres:5432, which is only the
# hostname other containers use on the docker-compose network.
DATABASE_URL=postgres://devfinops:devfinops@localhost:5432/devfinops

# Leave LANDING_ZONE_DIR unset unless you actually need to override it.
# ingest.js now loads this .env file (for the Jira auto-fetch vars
# below), and any value set here — even the "obvious" relative one —
# takes priority over ingest.js's own default, which correctly resolves
# to the repo-root landing_zone/ regardless of which directory you run
# `npm run ingest` from. Setting LANDING_ZONE_DIR=./landing_zone here
# would silently break that and point at a directory that doesn't exist
# relative to ingestion-service/. Only set this if you're intentionally
# pointing at a non-default location, and use an absolute path.
# LANDING_ZONE_DIR=/absolute/path/to/landing_zone

# Pepper for the developer_id hash ingest.js computes before anything
# touches raw_spans/raw_events/session_rollups/git_commits — see
# db/01_schema.sql's `developers` table comment. Change this before any
# real usage; the shipped default is intentionally not a secret.
DEVFINOPS_ID_SALT=devfinops-poc-default-salt-change-me


# cli-wrapper (cli-wrapper/devfinops-claude.js)
# ---------------------------------------------------------------------
# Only needed if the real Claude Code CLI binary isn't literally named
# `claude` on your PATH.
DEVFINOPS_CLAUDE_BIN=claude

# Where the wrapper points Claude Code's OTel export — matches the
# otel-collector port docker-compose publishes.
DEVFINOPS_OTLP_ENDPOINT=http://localhost:4317


# Used by jira-listener/fetch-ticket.js (pulls one issue on demand) AND
# ingestion-service/ingest.js (auto-fetches any issue_key seen in a
# session/commit that jira_issues doesn't have yet — see README's
# "Automatic Jira ticket fetching"). Generate a token at
# https://id.atlassian.com/manage-profile/security/api-tokens.
# NEVER put real values here — this file is committed. Put them in your
# own .env instead (gitignored) and `cp .env.example .env` to start it.
JIRA_HOST=https://your-domain.atlassian.net
JIRA_USER_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token-here